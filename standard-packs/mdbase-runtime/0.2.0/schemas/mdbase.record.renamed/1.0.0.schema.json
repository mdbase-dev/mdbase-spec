        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "patternProperties": {
        "^x-[A-Za-z0-9._:-]+$": true
      },
      "additionalProperties": false
    },
    "exactContractReference": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "patternProperties": {
        "^x-[A-Za-z0-9._:-]+$": true
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "application",
        "implementation",
        "version"
      ],
      "properties": {
        "application": {
          "type": "string",
